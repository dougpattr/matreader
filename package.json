{
  "name": "matreader",
  "version": "4.0.0",
  "private": true,
  "description": "MatReader — transforma matrículas de imóveis em documento conferido, desenha o terreno sobre satélite, junta PDFs e guarda tudo no aparelho. PWA offline em Ionic + Vue + TypeScript + WebAssembly.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && npm run build:wasm && vue-tsc --noEmit && vite build",
    "build:wasm": "asc wasm/geometry/assembly/index.ts --config wasm/geometry/asconfig.json --target release",
    "vendor": "node scripts/copy-vendor.mjs",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "scope": "node scripts/make-scope.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@ionic/vue": "^8.8.19",
    "@ionic/vue-router": "^8.8.19",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "tesseract.js": "^5.1.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tesseract.js-data/por": "^1.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "assemblyscript": "^0.27.37",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tesseract.js-core": "^5.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12",
    "workbox-window": "^7.4.1"
  }
}
